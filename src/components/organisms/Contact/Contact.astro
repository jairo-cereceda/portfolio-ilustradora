---
import DisponibilityCard from '@components/atoms/DisponibilityCard/DisponibilityCard.astro';
import { Icon } from 'astro-icon/components';
import { disponibility } from '../../../data/work-with-me/disponibility';

const { state } = disponibility;
---

<section
  class="bg-white shadow-primary-light p-5 rounded-3xl mx-5 sm:max-w-[70%] lg:max-w-[50%] my-0 md:mx-auto w-full relative"
  id="contact"
>
  <DisponibilityCard data={disponibility} />
  <div class="py-5">
    <h2 class="text-2xl font-semibold text-start md:text-center">Contáctame</h2>
  </div>
  <div class="flex flex-col gap-4 md:grid md:grid-cols-2 md:gap-0">
    <div class="md:pr-2 md:pb-0 md:mb-0 md:border-b-0">
      <fieldset disabled={!state}>
        <form
          id="contact-form"
          class=`flex flex-col gap-2 text-black w-full ${!state ? 'opacity-35' : ''}`
        >
          <input
            type="hidden"
            name="_subject"
            value="Nuevo mensaje desde mi portfolio"
          />
          <input type="text" name="_gotcha" style="display:none" />

          <div class="flex-col gap-2 w-full items-center relative">
            <label for="name" class="absolute text-sm top-0 left-2"
              >Tu nombre:</label
            >
            <input
              type="text"
              name="name"
              id="name"
              class="border border-black-light rounded-xl p-2 pt-4 w-full"
            />
          </div>

          <div class="flex-col gap-2 w-full items-center relative">
            <label for="email" class="absolute text-sm top-0 left-2"
              >Tu correo:</label
            >
            <input
              type="email"
              name="_replyto"
              id="email"
              class="border border-black-light rounded-xl p-2 pt-4 w-full"
            />
          </div>

          <div class="flex-col gap-2 w-full items-center relative">
            <label for="message" class="absolute text-sm top-0 left-2"
              >Mensaje:</label
            >
            <textarea
              name="message"
              id="message"
              required
              class="border border-black-light rounded-xl p-2 pt-4 w-full"
            ></textarea>
          </div>

          <button
            data-open-fictional-popup
            class="border-brand border px-10 py-2 self-center rounded-full text-brand font-bold hover:px-12 transition-all duration-200 ease cursor-pointer"
            >Enviar</button
          >
        </form>
      </fieldset>
    </div>
    <div class="flex flex-col gap-2 justify-center items-center">
      <h3 class="font-semibold">Si lo prefieres:</h3>
      <div>
        <button
          data-open-fictional-popup
          class=`relative overflow-hidden flex items-center gap-2 text-white bg-brand hover:px-8 px-6 py-2 rounded-3xl transition-all duration-200 ease cursor-pointer
            ${!state ? 'opacity-35 pointer-events-none' : ''}
          `
        >
          <Icon name="instagram" size={18} />
          <span class="relative z-20 font-bold"> Instagram </span>
        </button>
      </div>
    </div>
  </div>
</section>
