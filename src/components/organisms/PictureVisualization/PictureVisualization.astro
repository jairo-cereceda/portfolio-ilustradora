---
import { Icon } from 'astro-icon/components';
---

<dialog
  id="viewer"
  class="p-0 m-0 w-full h-full max-w-none max-h-none bg-black text-white open:flex flex-col overflow-hidden justify-between gap-5 open:animate-fade-in backdrop:bg-transparent
    lg:flex-row lg:bg-black/80"
  aria-labelledby="viewer-title"
  aria-describedby="viewer-desc"
>
  <button
    id="viewer-close"
    class="absolute top-2 right-2 cursor-pointer lg:left-0 lg:right-auto"
    aria-label="Cerrar visor de imagen"
    ><Icon
      name="close"
      class="text-white drop-shadow-[0_0_2px_rgba(0,0,0,1)] filter"
      size="32"
    /></button
  >
  <div
    class="w-full h-full min-h-0 flex items-center justify-center mx-auto my-0 lg:grow-0"
  >
    <img class="object-contain mt-5 lg:mt-0" id="viewer-img" />
  </div>
  <div
    id="viewer-text-panel"
    class="bg-primary relative p-5 pt-8 rounded-t-3xl shrink-0 flex flex-col max-h-[40vh] overflow-y-auto scrollbar-thin scrollbar-thumb-neutral-400 scrollbar-track-transparent wrap-break-word
        before:content-['']
         before:bg-[url('/img/noise.webp')]
         before:absolute
         before:inset-0
         before:opacity-[0.02]
         before:pointer-events-none
         before:z-10 before:rounded-3xl
        lg:shrink lg:max-w-medium-small lg:max-h-none lg:h-full lg:rounded-t-none lg:rounded-l-3xl"
  >
    <div>
      <h2 class="font-semibold text-xl" id="viewer-title"></h2>
      <p id="viewer-desc"></p>
    </div>
  </div>
</dialog>

<script is:inline>
  const viewer = document.getElementById('viewer');
  const img = document.getElementById('viewer-img');
  const title = document.getElementById('viewer-title');
  const desc = document.getElementById('viewer-desc');
  const closeBtn = document.getElementById('viewer-close');
  const currentPath = window.location.href;

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-thumb]');
    if (!btn) return;

    img.src = btn.dataset.src;
    img.alt = btn.dataset.alt;
    title.textContent = btn.dataset.title;
    desc.textContent = btn.dataset.desc;
    document.body.classList.add('overflow-y-hidden');

    img.onload = () => {
      const ratio = img.naturalWidth / img.naturalHeight;

      img.classList.remove('h-full', 'w-full');
      img.classList.add(ratio > 1 ? 'w-full' : 'h-full');
    };

    setTimeout(() => {
      viewer.showModal();
    }, 100);
  });

  const closeDialog = () => {
    document.body.classList.remove('overflow-y-hidden');

    viewer.classList.add(
      'opacity-0',
      'scale-95',
      'transition-all',
      'duration-200'
    );

    window.history.pushState({}, '', currentPath);

    setTimeout(() => {
      viewer.close();

      viewer.classList.remove(
        'opacity-0',
        'scale-95',
        'transition-all',
        'duration-200'
      );
    }, 200);
  };
  viewer.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.stopPropagation();
    }
  });

  viewer.addEventListener('click', (e) => {
    const isImage = e.target.id === 'viewer-img';
    const isTextPanel = e.target.closest('#viewer-text-panel');
    const isCloseBtn = e.target.closest('#viewer-close');
    if (!isImage && !isTextPanel && !isCloseBtn) {
      closeDialog();
    }
  });

  viewer.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeDialog();
  });

  closeBtn.addEventListener('click', closeDialog);
</script>
