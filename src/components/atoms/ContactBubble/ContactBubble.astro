---
import { Icon } from 'astro-icon/components';
---

<a
  class="fixed bottom-15 right-2 z-99 bg-darkblue text-white rounded-2xl px-5 py-2 flex items-center transition-transform duration-150 gap-2 hover:translate-x-[-2%]
    before:content-['']
    before:bg-[url('/img/noise.webp')]
    before:absolute
    before:inset-0
    before:opacity-[0.02]
    before:pointer-events-none
    before:z-10 before:rounded-3xl"
  href="/work-with-me"
>
  <Icon name="brush" size="18" />
  <p class="text-sm">Hazme un encargo!</p>
</a>
