---
import Footer from '@components/organisms/Footer/Footer.astro';
import Header from '@components/organisms/Header/Header.astro';
import PictureVisualization from '@components/organisms/PictureVisualization/PictureVisualization.astro';
import FirstLayout from './FirstLayout.astro';

export interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;

const pathname = Astro.url.pathname;
---

<FirstLayout pageTitle={pageTitle}>
  <div id="focus-start" tabindex="-1"></div>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-100 focus:bg-white"
    >Ir al contenido principal</a
  >
  <Header data={{ pathname }} />
  <main class="flex flex-col gap-5" id="main">
    <PictureVisualization />
    <slot />
  </main>

  <Footer />
</FirstLayout>

<script>
  document.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');

      const targetId = href?.split('#');

      if (!targetId) return;

      const target = document.querySelector(`#${targetId[1]}`);

      if (target) {
        e.preventDefault();

        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      }
    });
  });
</script>

<script is:inline>
  const popups = document.querySelectorAll('[data-popup]');
  const isTesting = navigator.webdriver;

  if (popups.length) {
    const closePopup = (popup) => {
      document.body.classList.remove('overflow-y-hidden');

      popup.classList.add(
        'opacity-0',
        'scale-95',
        'transition-all',
        'duration-200'
      );

      setTimeout(() => {
        popup.close();
        document.querySelector('#focus-start').focus();

        popup.classList.remove(
          'opacity-0',
          'scale-95',
          'transition-all',
          'duration-200'
        );
      }, 200);
      document.activeElement.blur();
    };

    popups.forEach((popup) => {
      const storageKey = `popup_seen_${window.location.pathname}`;
      const now = new Date().getTime();
      const oneDay = 24 * 60 * 60 * 1000;

      const lastSeen = localStorage.getItem(storageKey);

      if (popup.dataset.autoOpen === 'true') {
        if (lastSeen && now - lastSeen < oneDay) {
          return;
        }

        setTimeout(() => {
          if (!isTesting) {
            popup.showModal();
          }
          popup.focus();
          document.body.classList.add('overflow-y-hidden');

          localStorage.setItem(storageKey, now.toString());
        }, 2000);
      }

      popup.addEventListener('cancel', (e) => {
        e.preventDefault();
        closePopup(popup);
      });

      popup.addEventListener('click', (e) => {
        if (!e.target.closest('[data-popup-element]')) {
          closePopup(popup);
        }
      });

      const closeBtn = popup.querySelector('[data-popup-close]');

      closeBtn?.addEventListener('click', () => {
        closePopup(popup);
      });
    });
  }
</script>

<script>
  const links = document.querySelectorAll('[data-thumb]');

  links.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const url = link.getAttribute('href');

      window.history.pushState({}, '', url);
    });
  });
</script>

<script>
  const setupScrollReveal = () => {
    const isMobile = window.matchMedia('(max-width: 767px)').matches;
    const targets = document.querySelectorAll(
      '[data-thumb]'
    ) as NodeListOf<HTMLImageElement>;
    const isSmMansory = document
      .querySelector('[data-picture-list-animation]')
      ?.getAttribute('data-picture-list-animation');

    if (!isMobile && isSmMansory) {
      targets.forEach((img) => {
        img.classList.add('md:duration-2000');
        img.classList.remove('md:duration-150');

        setTimeout(() => {
          img.classList.remove('opacity-0');
          img.classList.add('opacity-100');
          setTimeout(() => {
            img.classList.remove('md:duration-2000');
            img.classList.add('md:duration-150');
          }, 1000);
        }, 500);
      });
    } else {
      const observerOptions = {
        root: null,
        threshold: 0.3,
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('opacity-0');
            entry.target.classList.add('opacity-100');
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      targets.forEach((target) => observer.observe(target));
    }
  };

  window.addEventListener('load', () => {
    setupScrollReveal();
  });
</script>
